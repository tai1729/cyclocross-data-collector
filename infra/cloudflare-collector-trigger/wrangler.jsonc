{
  "name": "cyclocross-data-collector",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "triggers": {
    "crons": ["7 0-14 * * *"]
  },
  "vars": {
    "DISPATCH_ENABLED": "false",
    "CALENDAR_URL": "https://raw.githubusercontent.com/tai1729/cyclocross-data-collector/main/race_days.json",
    "GITHUB_OWNER": "tai1729",
    "GITHUB_REPO": "cyclocross-data-collector",
    "WORKFLOW_FILE": "collect.yml",
    "DISPATCH_REF": "main"
  }
}
